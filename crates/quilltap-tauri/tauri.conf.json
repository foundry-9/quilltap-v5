{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quilltap",
  "version": "0.0.1",
  "identifier": "com.quilltap.desktop",
  "build": {
    "frontendDist": "../../apps/web/dist/quilltap/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Quilltap",
        "url": "qtap://localhost/",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
