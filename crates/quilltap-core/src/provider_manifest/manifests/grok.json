{
  "schemaVersion": 1,
  "id": "GROK",
  "displayName": "Grok (xAI)",
  "description": "Grok models by xAI with chat, vision, and image generation capabilities",
  "abbreviation": "XAI",
  "colors": {
    "bg": "bg-purple-100",
    "text": "text-purple-800",
    "icon": "text-purple-600"
  },
  "legacyNames": [],
  "auth": {
    "kind": "bearer"
  },
  "baseUrl": "https://api.x.ai/v1",
  "endpoints": {
    "chat": "/responses",
    "models": "/models"
  },
  "streamDecoder": "responses-api-sse",
  "requestTransform": "none",
  "toolFormat": "openai",
  "capabilities": {
    "chat": true,
    "imageGeneration": true,
    "embeddings": false,
    "webSearch": true,
    "toolUse": true
  },
  "optionsSchema": {
    "groups": [
      {
        "title": "Reasoning",
        "helpText": "Request a reasoning summary so the model's thinking can be shown in chat (display only; never re-fed to the model). Only the reasoning Grok models (e.g. grok-4, grok-4-fast-reasoning, grok-3-mini) produce one. xAI does not always expose a summary — if nothing appears, the model simply did not return one.",
        "fields": [
          {
            "key": "reasoningSummary",
            "label": "Show Reasoning Summary",
            "type": "boolean",
            "default": false
          }
        ]
      }
    ]
  },
  "configRequirements": {
    "requiresApiKey": true,
    "requiresBaseUrl": false,
    "apiKeyLabel": "Grok API Key",
    "baseUrlLabel": null,
    "baseUrlPlaceholder": null,
    "baseUrlDefault": null
  },
  "messageFormat": {
    "supportsNameField": true,
    "supportedRoles": [
      "user",
      "assistant"
    ],
    "maxNameLength": 64
  },
  "cheapModels": {
    "defaultModel": "grok-3-mini",
    "recommendedModels": [
      "grok-3-mini",
      "grok-4-1-fast"
    ]
  },
  "attachment": {
    "supportsAttachments": true,
    "supportedMimeTypes": [
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/webp"
    ],
    "description": "Images only (JPEG, PNG, GIF, WebP)",
    "notes": "Images are supported in Grok models for vision capabilities",
    "maxFileSize": null,
    "maxBase64Size": 20971520,
    "maxFiles": null
  },
  "charsPerToken": 3.5,
  "defaultContextWindow": 131072,
  "imageGenerationModels": ["grok-imagine-image", "grok-imagine-image-pro", "grok-2-image"],
  "fallbackModels": [
    "grok-4",
    "grok-4-1-fast",
    "grok-3",
    "grok-3-mini",
    "grok-2-1212",
    "grok-code-fast-1",
    "grok-imagine-image",
    "grok-imagine-image-pro",
    "grok-2-image"
  ],
  "pricing": {}
}
