{
  "schemaVersion": 1,
  "id": "OPENROUTER",
  "displayName": "OpenRouter",
  "description": "OpenRouter provides access to 100+ models including GPT-4, Claude, Gemini, Llama and more with unified pricing",
  "abbreviation": "ORT",
  "colors": {
    "bg": "bg-orange-100",
    "text": "text-orange-800",
    "icon": "text-orange-600"
  },
  "legacyNames": [],
  "auth": {
    "kind": "bearer"
  },
  "baseUrl": "https://openrouter.ai/api/v1",
  "endpoints": {
    "chat": "/chat/completions",
    "models": "/models"
  },
  "streamDecoder": "chat-completions-sse",
  "requestTransform": "none",
  "toolFormat": "openai",
  "capabilities": {
    "chat": true,
    "imageGeneration": true,
    "embeddings": true,
    "webSearch": true,
    "toolUse": false
  },
  "optionsSchema": {
    "groups": [
      {
        "title": "OpenRouter Options",
        "fields": [
          {
            "key": "enableZDR",
            "label": "Enable Zero Data Retention (ZDR)",
            "helpText": "Providers will not store or log your prompts and responses.",
            "type": "boolean",
            "default": false
          },
          {
            "key": "useCustomModel",
            "label": "Use Custom Model ID",
            "helpText": "Enter an arbitrary model ID not in the fetched list.",
            "type": "boolean",
            "default": false,
            "affects": "modelInput"
          },
          {
            "key": "fallbackModels",
            "label": "Fallback Models (max 2)",
            "type": "multi-enum",
            "multiEnumSource": "fetchedModels",
            "max": 2,
            "default": []
          }
        ]
      }
    ]
  },
  "configRequirements": {
    "requiresApiKey": true,
    "requiresBaseUrl": false,
    "apiKeyLabel": "OpenRouter API Key",
    "baseUrlLabel": null,
    "baseUrlPlaceholder": null,
    "baseUrlDefault": null
  },
  "messageFormat": {
    "supportsNameField": false,
    "supportedRoles": [],
    "maxNameLength": null
  },
  "cheapModels": {
    "defaultModel": "openai/gpt-4o-mini",
    "recommendedModels": [
      "openai/gpt-4o-mini",
      "anthropic/claude-3-haiku",
      "google/gemini-2.0-flash",
      "mistralai/mistral-7b-instruct"
    ]
  },
  "attachment": {
    "supportsAttachments": false,
    "supportedMimeTypes": [],
    "description": "File attachment support depends on the underlying model",
    "notes": "OpenRouter proxies to 100+ models with varying capabilities. Some models may support image/file attachments.",
    "maxFileSize": null,
    "maxBase64Size": null,
    "maxFiles": null
  },
  "charsPerToken": 3.5,
  "defaultContextWindow": 128000,
  "imageGenerationModels": ["google/gemini-2.0-flash-exp:free", "google/gemini-2.5-flash-preview-05-20", "google/gemini-2.5-flash-preview-native-image", "google/gemini-3-pro-image-preview"],
  "fallbackModels": [
    "openai/gpt-4-turbo",
    "anthropic/claude-3-opus",
    "anthropic/claude-3-sonnet",
    "google/gemini-pro-1.5",
    "meta-llama/llama-2-70b-chat",
    "mistralai/mistral-7b-instruct"
  ],
  "pricing": {}
}
