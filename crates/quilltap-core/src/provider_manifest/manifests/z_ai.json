{
  "schemaVersion": 1,
  "id": "Z_AI",
  "displayName": "Z.AI (GLM)",
  "description": "Z.AI GLM models with chat, vision, tool use, web search, and CogView image generation",
  "abbreviation": "ZAI",
  "colors": {
    "bg": "bg-emerald-100",
    "text": "text-emerald-800",
    "icon": "text-emerald-600"
  },
  "legacyNames": [],
  "auth": {
    "kind": "bearer"
  },
  "baseUrl": "https://api.z.ai/api/paas/v4",
  "endpoints": {
    "chat": "/chat/completions",
    "models": "/models"
  },
  "streamDecoder": "chat-completions-sse",
  "requestTransform": "none",
  "toolFormat": "openai",
  "capabilities": {
    "chat": true,
    "imageGeneration": true,
    "embeddings": false,
    "webSearch": true,
    "toolUse": true
  },
  "optionsSchema": {
    "groups": [
      {
        "title": "Z.AI Options",
        "helpText": "Thinking mode enables the GLM reasoning models' extended chain-of-thought, shown in the Salon (display only; never re-fed to the model). Only the hybrid-reasoning GLM models (glm-4.5/4.6 family, glm-5.x) produce it; with thinking off, nothing appears.",
        "fields": [
          {
            "key": "thinking",
            "label": "Thinking Mode",
            "type": "enum",
            "default": "",
            "enumValues": [
              {
                "value": "",
                "label": "(model default)"
              },
              {
                "value": "enabled",
                "label": "Enabled"
              },
              {
                "value": "disabled",
                "label": "Disabled"
              }
            ]
          },
          {
            "key": "reasoning_effort",
            "label": "Reasoning Effort",
            "type": "enum",
            "default": "",
            "helpText": "A dial for how hard glm-5.2 cogitates before it speaks (thinking must be lit; lesser models pay it no heed). Minimal all but silences the rumination; High and Max open the throttle — and mind that low and medium quietly fold up to High, xhigh up to Max. Leave it at (model default) and glm-5.2 still sets to High of its own accord, sparing you the API's spendthrift Max.",
            "enumValues": [
              {
                "value": "",
                "label": "(model default)"
              },
              {
                "value": "minimal",
                "label": "Minimal"
              },
              {
                "value": "high",
                "label": "High"
              },
              {
                "value": "max",
                "label": "Max"
              }
            ]
          }
        ]
      }
    ]
  },
  "configRequirements": {
    "requiresApiKey": true,
    "requiresBaseUrl": false,
    "apiKeyLabel": "Z.AI API Key",
    "baseUrlLabel": null,
    "baseUrlPlaceholder": null,
    "baseUrlDefault": null
  },
  "messageFormat": {
    "supportsNameField": true,
    "supportedRoles": [
      "user",
      "assistant"
    ],
    "maxNameLength": 64
  },
  "cheapModels": {
    "defaultModel": "glm-4.5-flash",
    "recommendedModels": [
      "glm-4.5-flash",
      "glm-4.5-air"
    ]
  },
  "attachment": {
    "supportsAttachments": true,
    "supportedMimeTypes": [
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/webp"
    ],
    "description": "Images (JPEG, PNG, GIF, WebP) — requires a vision model (e.g. glm-4.5v, glm-4.6v)",
    "notes": "Z.AI vision models accept image URLs or base64; limit 5MB per image, max 6000×6000 pixels.",
    "maxFileSize": null,
    "maxBase64Size": 5242880,
    "maxFiles": null
  },
  "charsPerToken": 3.5,
  "defaultContextWindow": 131072,
  "imageGenerationModels": ["cogview-4-250304", "glm-image"],
  "fallbackModels": [
    "glm-4.6",
    "glm-4.5",
    "glm-4.5-x",
    "glm-4.5-air",
    "glm-4.5-airx",
    "glm-4.5-flash",
    "glm-4-32b-0414-128k",
    "glm-4.6v",
    "glm-4.6v-flashx",
    "glm-4.6v-flash",
    "glm-5v-turbo",
    "glm-4.5v",
    "cogview-4-250304",
    "glm-image"
  ],
  "pricing": {}
}
