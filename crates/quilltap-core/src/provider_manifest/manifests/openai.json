{
  "schemaVersion": 1,
  "id": "OPENAI",
  "displayName": "OpenAI",
  "description": "OpenAI GPT models including GPT-4o and DALL-E image generation",
  "abbreviation": "OAI",
  "colors": {
    "bg": "bg-green-100",
    "text": "text-green-800",
    "icon": "text-green-600"
  },
  "legacyNames": [],
  "auth": {
    "kind": "bearer"
  },
  "baseUrl": "https://api.openai.com/v1",
  "endpoints": {
    "chat": "/responses",
    "models": "/models"
  },
  "streamDecoder": "responses-api-sse",
  "requestTransform": "openai",
  "toolFormat": "openai",
  "capabilities": {
    "chat": true,
    "imageGeneration": true,
    "embeddings": true,
    "webSearch": true,
    "toolUse": true
  },
  "optionsSchema": {
    "groups": [
      {
        "title": "OpenAI Options",
        "fields": [
          {
            "key": "verbosity",
            "label": "Verbosity",
            "type": "enum",
            "default": "",
            "helpText": "Scales how long and detailed the answer is. Supported on GPT-5 and newer models; older models will ignore it.",
            "enumValues": [
              {
                "value": "",
                "label": "(model default)"
              },
              {
                "value": "low",
                "label": "Low"
              },
              {
                "value": "medium",
                "label": "Medium"
              },
              {
                "value": "high",
                "label": "High"
              }
            ]
          },
          {
            "key": "reasoningEffort",
            "label": "Reasoning Effort",
            "type": "enum",
            "default": "",
            "helpText": "How hard the model thinks before responding. Applies to reasoning models (o-series, GPT-5); ignored on non-reasoning models. Background tasks always use Low regardless of this setting.",
            "enumValues": [
              {
                "value": "",
                "label": "(model default)"
              },
              {
                "value": "minimal",
                "label": "Minimal"
              },
              {
                "value": "low",
                "label": "Low"
              },
              {
                "value": "medium",
                "label": "Medium"
              },
              {
                "value": "high",
                "label": "High"
              }
            ]
          }
        ]
      },
      {
        "title": "Reasoning",
        "helpText": "Request a reasoning summary so the model's thinking can be shown in chat (display only; never re-fed to the model). Only the reasoning OpenAI models (GPT-5, o-series) produce one. OpenAI does not always expose a summary — if nothing appears, the model simply did not return one.",
        "fields": [
          {
            "key": "reasoningSummary",
            "label": "Show Reasoning Summary",
            "type": "boolean",
            "default": false
          }
        ]
      }
    ]
  },
  "configRequirements": {
    "requiresApiKey": true,
    "requiresBaseUrl": false,
    "apiKeyLabel": "OpenAI API Key",
    "baseUrlLabel": null,
    "baseUrlPlaceholder": null,
    "baseUrlDefault": null
  },
  "messageFormat": {
    "supportsNameField": true,
    "supportedRoles": [
      "user",
      "assistant"
    ],
    "maxNameLength": 64
  },
  "cheapModels": {
    "defaultModel": "gpt-4o-mini",
    "recommendedModels": [
      "gpt-4o-mini",
      "gpt-3.5-turbo"
    ]
  },
  "attachment": {
    "supportsAttachments": true,
    "supportedMimeTypes": [
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/webp"
    ],
    "description": "Images only (JPEG, PNG, GIF, WebP)",
    "notes": "Images are supported in vision-capable models like GPT-4V and GPT-4o",
    "maxFileSize": null,
    "maxBase64Size": 20971520,
    "maxFiles": null
  },
  "charsPerToken": 3.5,
  "defaultContextWindow": 128000,
  "imageGenerationModels": ["gpt-image-2", "gpt-image-1.5", "gpt-image-1", "gpt-image-1-mini", "dall-e-3", "dall-e-2"],
  "fallbackModels": [
    "gpt-4o",
    "gpt-4-turbo",
    "gpt-4",
    "gpt-3.5-turbo"
  ],
  "pricing": {}
}
