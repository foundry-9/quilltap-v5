{
  "schemaVersion": 1,
  "id": "DEEPSEEK",
  "displayName": "DeepSeek",
  "description": "DeepSeek V4 chat and reasoning models",
  "abbreviation": "DSK",
  "colors": {
    "bg": "bg-sky-100",
    "text": "text-sky-800",
    "icon": "text-sky-600"
  },
  "legacyNames": [],
  "auth": {
    "kind": "bearer"
  },
  "baseUrl": "https://api.deepseek.com",
  "endpoints": {
    "chat": "/chat/completions",
    "models": "/models"
  },
  "streamDecoder": "chat-completions-sse",
  "requestTransform": "deepseek",
  "toolFormat": "openai",
  "capabilities": {
    "chat": true,
    "imageGeneration": false,
    "embeddings": false,
    "webSearch": false,
    "toolUse": true
  },
  "optionsSchema": {
    "groups": [
      {
        "title": "DeepSeek Options",
        "helpText": "The V4 models reason before answering by default, so \"(model default)\" means thinking is ON — set Disabled to turn it off. While thinking, temperature, top_p, and frequency / presence penalties are ignored, and Quilltap anchors multi-character turns in prose rather than with a [Name] prefill, which DeepSeek rejects mid-thinking.",
        "fields": [
          {
            "key": "thinking",
            "label": "Thinking Mode",
            "type": "enum",
            "default": "",
            "enumValues": [
              {
                "value": "",
                "label": "(model default)"
              },
              {
                "value": "enabled",
                "label": "Enabled"
              },
              {
                "value": "disabled",
                "label": "Disabled"
              }
            ]
          },
          {
            "key": "reasoning_effort",
            "label": "Reasoning Effort",
            "type": "enum",
            "default": "",
            "helpText": "DeepSeek's reasoning scale. low/medium fold to high; xhigh folds to max.",
            "enumValues": [
              {
                "value": "",
                "label": "(model default)"
              },
              {
                "value": "high",
                "label": "High"
              },
              {
                "value": "max",
                "label": "Max"
              }
            ]
          }
        ]
      }
    ]
  },
  "thinkingTurnRule": {
    "optionKey": "thinking",
    "enabledValues": [
      "enabled"
    ],
    "disabledValues": [
      "disabled"
    ]
  },
  "configRequirements": {
    "requiresApiKey": true,
    "requiresBaseUrl": false,
    "apiKeyLabel": "DeepSeek API Key",
    "baseUrlLabel": null,
    "baseUrlPlaceholder": null,
    "baseUrlDefault": null
  },
  "messageFormat": {
    "supportsNameField": true,
    "supportedRoles": [
      "user",
      "assistant"
    ],
    "maxNameLength": 64
  },
  "cheapModels": {
    "defaultModel": "deepseek-v4-flash",
    "recommendedModels": [
      "deepseek-v4-flash"
    ]
  },
  "attachment": {
    "supportsAttachments": false,
    "supportedMimeTypes": [],
    "description": "DeepSeek models do not accept file attachments",
    "notes": null,
    "maxFileSize": null,
    "maxBase64Size": null,
    "maxFiles": null
  },
  "charsPerToken": 3.5,
  "defaultContextWindow": 131072,
  "fallbackModels": [
    "deepseek-v4-flash",
    "deepseek-v4-pro"
  ],
  "models": [
    {
      "id": "deepseek-v4-flash",
      "supportsThinking": true,
      "thinksByDefault": true
    },
    {
      "id": "deepseek-v4-pro",
      "supportsThinking": true,
      "thinksByDefault": true
    }
  ],
  "pricing": {}
}
