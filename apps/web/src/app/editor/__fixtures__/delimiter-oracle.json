  "source": [
    {
      "name": "wrap: a selected word gets the string delimiter on both sides",
      "delimiter": {
        "kind": "wrap",
        "name": "Thoughts",
        "buttonName": "Th",
        "delimiters": "~",
        "style": "qt-rp-thoughts"
      },
      "narration": null,
      "in": {
        "value": "hello world",
        "start": 0,
        "end": 5
      },
      "out": {
        "value": "~hello~ world",
        "cursor": 7
      }
    },
    {
      "name": "wrap: an already-wrapped selection unwraps",
      "delimiter": {
        "kind": "wrap",
        "name": "Thoughts",
        "buttonName": "Th",
        "delimiters": "~",
        "style": "qt-rp-thoughts"
      },
      "narration": null,
      "in": {
        "value": "~hello~ world",
        "start": 0,
        "end": 7
      },
      "out": {
        "value": "hello world",
        "cursor": 5
      }
    },
    {
      "name": "wrap: an empty selection inserts the pair and centers the caret",
      "delimiter": {
        "kind": "wrap",
        "name": "Thoughts",
        "buttonName": "Th",
        "delimiters": "~",
        "style": "qt-rp-thoughts"
      },
      "narration": null,
      "in": {
        "value": "ab",
        "start": 1,
        "end": 1
      },
      "out": {
        "value": "a~~b",
        "cursor": 2
      }
    },
    {
      "name": "wrap: a tuple delimiter uses open and close",
      "delimiter": {
        "kind": "wrap",
        "name": "Aside",
        "buttonName": "As",
        "delimiters": [
          "((",
          "))"
        ],
        "style": "qt-rp-aside"
      },
      "narration": null,
      "in": {
        "value": "hello world",
        "start": 6,
        "end": 11
      },
      "out": {
        "value": "hello ((world))",
        "cursor": 15
      }
    },
    {
      "name": "wrap: a multi-line selection is wrapped as one span",
      "delimiter": {
        "kind": "wrap",
        "name": "Aside",
        "buttonName": "As",
        "delimiters": [
          "((",
          "))"
        ],
        "style": "qt-rp-aside"
      },
      "narration": null,
      "in": {
        "value": "one\ntwo",
        "start": 0,
        "end": 7
      },
      "out": {
        "value": "((one\ntwo))",
        "cursor": 11
      }
    },
    {
      "name": "linePrefix: a caret on an unprefixed line adds the marker",
      "delimiter": {
        "kind": "linePrefix",
        "name": "Out of character",
        "buttonName": "OOC",
        "marker": "// ",
        "style": "qt-rp-ooc"
      },
      "narration": null,
      "in": {
        "value": "a note",
        "start": 3,
        "end": 3
      },
      "out": {
        "value": "// a note",
        "cursor": 9
      }
    },
    {
      "name": "linePrefix: a caret on an already-prefixed line removes it",
      "delimiter": {
        "kind": "linePrefix",
        "name": "Out of character",
        "buttonName": "OOC",
        "marker": "// ",
        "style": "qt-rp-ooc"
      },
      "narration": null,
      "in": {
        "value": "// a note",
        "start": 5,
        "end": 5
      },
      "out": {
        "value": "a note",
        "cursor": 6
      }
    },
    {
      "name": "linePrefix: a mixed multi-line selection ADDS to every line",
      "delimiter": {
        "kind": "linePrefix",
        "name": "Out of character",
        "buttonName": "OOC",
        "marker": "// ",
        "style": "qt-rp-ooc"
      },
      "narration": null,
      "in": {
        "value": "// one\ntwo\nthree",
        "start": 0,
        "end": 16
      },
      "out": {
        "value": "// // one\n// two\n// three",
        "cursor": 25
      }
    },
    {
      "name": "linePrefix: an all-prefixed multi-line selection removes from every line",
      "delimiter": {
        "kind": "linePrefix",
        "name": "Out of character",
        "buttonName": "OOC",
        "marker": "// ",
        "style": "qt-rp-ooc"
      },
      "narration": null,
      "in": {
        "value": "// one\n// two",
        "start": 0,
        "end": 13
      },
      "out": {
        "value": "one\ntwo",
        "cursor": 7
      }
    },
    {
      "name": "linePrefix: a partial-line selection expands to whole lines first",
      "delimiter": {
        "kind": "linePrefix",
        "name": "Out of character",
        "buttonName": "OOC",
        "marker": "// ",
        "style": "qt-rp-ooc"
      },
      "narration": null,
      "in": {
        "value": "alpha\nbeta\ngamma",
        "start": 7,
        "end": 8
      },
      "out": {
        "value": "alpha\n// beta\ngamma",
        "cursor": 13
      }
    },
    {
      "name": "tagPrefix: inserts the bracket pair at the line start, caret between",
      "delimiter": {
        "kind": "tagPrefix",
        "name": "Rank",
        "buttonName": "Rank",
        "open": "[",
        "close": "]",
        "style": "qt-rp-rank"
      },
      "narration": null,
      "in": {
        "value": "reporting for duty",
        "start": 9,
        "end": 9
      },
      "out": {
        "value": "[]reporting for duty",
        "cursor": 1
      }
    },
    {
      "name": "tagPrefix: the SECOND line gets its own pair",
      "delimiter": {
        "kind": "tagPrefix",
        "name": "Rank",
        "buttonName": "Rank",
        "open": "[",
        "close": "]",
        "style": "qt-rp-rank"
      },
      "narration": null,
      "in": {
        "value": "one\ntwo",
        "start": 5,
        "end": 5
      },
      "out": {
        "value": "one\n[]two",
        "cursor": 5
      }
    },
    {
      "name": "tagPrefix: an existing pair is NOT toggled off — a second click stacks",
      "delimiter": {
        "kind": "tagPrefix",
        "name": "Rank",
        "buttonName": "Rank",
        "open": "[",
        "close": "]",
        "style": "qt-rp-rank"
      },
      "narration": null,
      "in": {
        "value": "[]hello",
        "start": 1,
        "end": 1
      },
      "out": {
        "value": "[][]hello",
        "cursor": 1
      }
    },
    {
      "name": "narration: the synthesized button wraps with the template narration char",
      "delimiter": {
        "kind": "wrap",
        "name": "Narration",
        "buttonName": "Nar",
        "delimiters": "*",
        "style": "qt-chat-narration"
      },
      "narration": "*",
      "in": {
        "value": "she smiled",
        "start": 0,
        "end": 10
      },
      "out": {
        "value": "*she smiled*",
        "cursor": 12
      }
    },
    {
      "name": "narration: a tuple narration wraps with open and close",
      "delimiter": {
        "kind": "wrap",
        "name": "Narration",
        "buttonName": "Nar",
        "delimiters": [
          "[",
          "]"
        ],
        "style": "qt-chat-narration"
      },
      "narration": [
        "[",
        "]"
      ],
      "in": {
        "value": "she smiled",
        "start": 4,
        "end": 10
      },
      "out": {
        "value": "she [smiled]",
        "cursor": 12
      }
    }
  ],
