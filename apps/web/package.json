{
  "name": "quilltap-spa",
  "version": "0.5.539",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node tools/ng-run.mjs build",
    "build:raw": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node tools/ng-run.mjs test --watch=false",
    "test:raw": "ng test",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@tanstack/angular-query-experimental": "^5.101.2",
    "@tanstack/angular-virtual": "5.0.7",
    "@tauri-apps/api": "^2.11.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "croner": "^10.0.1",
    "katex": "0.18.4",
    "markdown-it": "^14.3.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.5",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.1",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-stringify": "10.0.1",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-smartypants": "3.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
