   "messages": [
    {
     "id": "ea000001-0000-4000-8000-000000000001",
     "role": "USER",
     "content": "I told her we sail at dawn, whatever the harbourmaster says.",
     "participantId": "5c000000-0000-4000-8000-00000000000c",
     "createdAt": "2026-07-14T09:01:00.000Z"
    },
    {
     "id": "ea000002-0000-4000-8000-000000000002",
     "role": "ASSISTANT",
     "content": "Then I will ready the Gull tonight and post the watch myself.",
     "participantId": "5a000000-0000-4000-8000-00000000000a",
     "createdAt": "2026-07-14T09:02:00.000Z"
    },
    {
     "id": "ea000003-0000-4000-8000-000000000003",
     "role": "ASSISTANT",
     "content": "I will bargain with the harbourmaster for the berth fee.",
     "participantId": "5b000000-0000-4000-8000-00000000000b",
     "createdAt": "2026-07-14T09:03:00.000Z"
    },
    {
     "id": "ea000004-0000-4000-8000-000000000004",
     "role": "ASSISTANT",
     "content": "And I will chart the reef passage before the tide turns.",
     "participantId": "5a000000-0000-4000-8000-00000000000a",
     "createdAt": "2026-07-14T09:04:00.000Z"
    },
    {
     "id": "ea000005-0000-4000-8000-000000000005",
     "role": "USER",
     "content": "Good. Bram, keep the brass sextant safe.",
     "participantId": "5c000000-0000-4000-8000-00000000000c",
     "createdAt": "2026-07-14T09:05:00.000Z"
    },
    {
     "id": "ea000006-0000-4000-8000-000000000006",
     "role": "ASSISTANT",
     "content": "It never leaves my coat until we reach Lighthouse Point.",
     "participantId": "5b000000-0000-4000-8000-00000000000b",
     "createdAt": "2026-07-14T09:06:00.000Z"
    }
   ]
  },
