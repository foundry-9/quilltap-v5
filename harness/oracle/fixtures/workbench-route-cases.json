{
  "_comment": "P4.6ay unit 12 route corpus, read by BOTH the jest oracle (pascal-workbench-route.test.ts) and the Rust differential (pascal_workbench_route_equivalence.rs) so the two sides cannot drift apart. Character ids match harness/oracle/fixtures/workbench.json. Every roll is min===max, so preview and audit are deterministic without a shared draw stream.",
  "characters": {
    "imogen": "a1000000-0000-4000-8000-00000000000a",
    "vaultless": "a1000000-0000-4000-8000-00000000000b",
    "cracked": "a1000000-0000-4000-8000-00000000000c",
    "unknown": "a1000000-0000-4000-8000-0000000000ff"
  },
  "definitions": {
    "gated": {
      "name": "gated",
      "title": "The Gated Table",
      "description": "A table that consults the sheet.",
      "roll": {
        "min": 0.8,
        "max": 0.8
      },
      "outcomes": [
        {
          "when": {
            "gt": 0.5,
            "metadata": {
              "hasKey": {
                "eq": true
              }
            }
          },
          "message": "The lock turns for {{value}}.",
          "state": "success"
        },
        {
          "when": true,
          "message": "The lock holds.",
          "state": "failure"
        }
      ]
    },
    "plain": {
      "name": "plain",
      "description": "A table with no conditions worth the name.",
      "roll": {
        "min": 3,
        "max": 3
      },
      "parameters": {
        "bonus": {
          "type": "integer",
          "default": 1,
          "min": 0,
          "max": 5
        }
      },
      "outcomes": [
        {
          "when": true,
          "message": "Dealt {{value}} at {{params.bonus}}.",
          "state": "info"
        }
      ]
    },
    "banded": {
      "name": "banded",
      "description": "Three bands over one fixed draw.",
      "roll": {
        "min": 0.25,
        "max": 0.25
      },
      "outcomes": [
        {
          "when": {
            "gte": 0.75
          },
          "message": "high",
          "state": "success"
        },
        {
          "when": {
            "gte": 0.5
          },
          "message": "mid",
          "state": "partial"
        },
        {
          "when": true,
          "message": "low",
          "state": "failure"
        }
      ]
    },
    "invertedRange": {
      "name": "inverted_range",
      "description": "A range the house cannot deal.",
      "roll": {
        "min": 9,
        "max": 2
      },
      "outcomes": [
        {
          "when": true,
          "message": "unreachable",
          "state": "info"
        }
      ]
    },
    "invalid": {
      "name": "Not An Identifier",
      "description": "",
      "outcomes": []
    },
    "noCatchAll": {
      "name": "no_catch_all",
      "description": "Every row is conditional, so a deal could find no home.",
      "roll": {
        "min": 0.5,
        "max": 0.5
      },
      "outcomes": [
        {
          "when": {
            "gte": 0.9
          },
          "message": "only sometimes",
          "state": "info"
        }
      ]
    },
    "oracle": {
      "name": "oracle",
      "title": "The Consulted Table",
      "description": "A table that asks a separate model.",
      "roll": {
        "min": 0.8,
        "max": 0.8
      },
      "llm": {
        "prompt": "The draw was {{value}}. Answer YES or NO.",
        "errorMessage": "The wire went dead.",
        "maxOutput": 12
      },
      "outcomes": [
        {
          "when": {
            "llm": {
              "ok": true,
              "eq": "YES"
            }
          },
          "message": "Granted: {{llm}}",
          "state": "success"
        },
        {
          "when": {
            "llm": {
              "ok": true
            }
          },
          "message": "Answered: {{llm}}",
          "state": "partial"
        },
        {
          "when": true,
          "message": "Silence: {{llm}}",
          "state": "failure"
        }
      ]
    },
    "stateGate": {
      "name": "state_gate",
      "title": "The State Gate",
      "description": "A table that reads the merged state.",
      "roll": {
        "min": {
          "$state": "game.n",
          "fallback": 4
        },
        "max": {
          "$state": "game.n",
          "fallback": 4
        }
      },
      "outcomes": [
        {
          "when": {
            "gte": {
              "$state": "game.difficulty",
              "fallback": 10
            }
          },
          "message": "Cleared at {{value}} ({{state.banner}}).",
          "state": "success"
        },
        {
          "when": true,
          "message": "Short at {{value}}.",
          "state": "failure"
        }
      ]
    }
  },
