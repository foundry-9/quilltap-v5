  "mutations": [
    {
      "name": "characters_denulled",
      "from": "characters_all_memories",
      "$comment": "v4's exporter emits SQL NULLs for optional string columns and its own schema forbids them (`type: string`, never nullable) \u2014 the raw seed is INVALID with 33 such errors, a recorded v4 observation. Dropping every null property yields the rich VALID document the positive arms and the interesting mutations below are derived from.",
      "ops": [
        {
          "op": "dropNulls",
          "path": "/data"
        }
      ]
    },
    {
      "name": "characters_valid_rich",
      "from": "characters_denulled",
      "$comment": "The denulled seed is STILL invalid: `ExportedDocumentStoreBlob` REQUIRES `originalFileName` and `originalMimeType`, and v4's exporter emits SQL NULL for both (a second recorded v4 observation). Dropping the blob section leaves the rich, deeply-nested, VALID characters export the interesting mutations below are derived from \u2014 so each of them flips `valid` true \u2192 false rather than adding an error to an already-broken document.",
      "ops": [
        {
          "op": "remove",
          "path": "/data/blobs"
        }
      ]
    },
