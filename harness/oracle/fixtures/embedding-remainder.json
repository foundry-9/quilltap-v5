  "dimensionReconcileCases": [
    {
      "name": "builtin-default-skips",
      "comment": "P4.d27 — the corpus default IS the BUILTIN profile, so the very first pass must be a total no-op: a TF-IDF profile's dimension is the fitted vocabulary size, which the refit pipeline owns. No prelude.",
      "setDefaultProfileId": null,
      "clearDefault": false
    },
    {
      "name": "no-fixed-dim-warns",
      "comment": "A non-BUILTIN default that declares neither truncateToDimensions nor dimensions. The prelude points isDefault at the third profile, which exists only for this arm.",
      "setDefaultProfileId": "b0000000-0000-4000-8000-000000000003",
      "clearDefault": false
    },
    {
      "name": "enforces-target-dim-and-enqueues",
      "comment": "The meaty arm: the 8-dimension OPENAI profile becomes the default, so every legacy-width vector in the corpus is non-conforming. Deletes the two legacy vector entries, snaps the index meta, NULLs the stale chat's chunk, counts the recoverable rows, and enqueues ONE mismatched-dim reindex.",
      "setDefaultProfileId": "b0000000-0000-4000-8000-000000000002",
      "clearDefault": false
    },
    {
      "name": "second-pass-dedupes",
      "comment": "Immediately again, with no prelude: the reindex the previous case enqueued is still PENDING, so findRecentByType finds it and this pass must NOT stack a second one. The counts stay non-zero (nothing has drained), which is what makes the dedupe the only thing that changed.",
      "setDefaultProfileId": null,
      "clearDefault": false
    },
    {
      "name": "no-default-profile-skips",
      "comment": "With isDefault cleared everywhere, the profile lookup finds nothing.",
      "setDefaultProfileId": null,
      "clearDefault": true
    },
    {
      "name": "restores-the-builtin-default",
      "comment": "The phase runs BEFORE the reindex cases (so its DELETE and meta-snap arms have vector rows to act on), which means it must hand the corpus back exactly as it found it. Putting the BUILTIN profile back also re-proves the skip on a corpus the earlier cases have already changed.",
      "setDefaultProfileId": "b0000000-0000-4000-8000-000000000001",
      "clearDefault": false
    }
  ],
